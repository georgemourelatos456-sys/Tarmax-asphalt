# ---------------------------------------------------------------------------
# TARMAX Asphalt — environment variables
#
# Copy to `.env.local` and fill in. The site builds and runs without any of
# these; email degrades gracefully to a server log so local development never
# blocks on credentials. Configure Resend before going to production.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Used for metadata, Open Graph,
# sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://tarmaxasphalt.com

# --- Resend ---------------------------------------------------------------
# Server only. This is the whole backend: a quote request is emailed to the
# shared mailbox and both directors, and that email is the lead record. Without
# it, submissions are validated and logged but never reach anyone.
RESEND_API_KEY=

# Verified sending identity on your Resend domain.
RESEND_FROM="TARMAX Asphalt <quotes@tarmaxasphalt.com>"

# Quote-form submissions allowed per client per 15 minutes. Defaults to 10.
# Raise it only if you have a legitimate reason; lower it if you see abuse.
QUOTE_RATE_LIMIT_MAX=10
