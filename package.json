{
  "name": "tarmax-asphalt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/resolve-surfaces.mjs && next dev",
    "build": "node scripts/resolve-surfaces.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "textures": "node scripts/generate-textures.mjs",
