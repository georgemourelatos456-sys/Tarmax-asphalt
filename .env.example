# ---------------------------------------------------------------------------
# TARMAX Asphalt — environment variables
#
# Copy to `.env.local` and fill in. The site builds and runs without any of
# these; integrations degrade gracefully so local development never blocks on
# credentials. Configure them all before going to production.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Used for metadata, Open Graph,
# sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://tarmaxasphalt.com

# --- Supabase -------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser; they are used by
# the /admin sign-in flow.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY. Bypasses row level security, so it must never
# be referenced from client components or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend ---------------------------------------------------------------
# Server only. Sends the admin notification and the customer confirmation.
RESEND_API_KEY=

# Verified sending identity on your Resend domain.
RESEND_FROM="TARMAX Asphalt <quotes@tarmaxasphalt.com>"

# Quote-form submissions allowed per client per 15 minutes. Defaults to 10.
# Raise it only if you have a legitimate reason; lower it if you see abuse.
QUOTE_RATE_LIMIT_MAX=10

# Extra addresses allowed into /admin, comma separated. The two directors and
# the general mailbox are always allowed. Being signed in is NOT enough — an
# account must be on this list, so a stray Supabase sign-up cannot read leads.
ADMIN_EMAILS=
